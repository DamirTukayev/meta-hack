# Copy to .env and fill in. Never commit .env. Backend only.

# Meta Model API (name matches the official docs)
MODEL_API_KEY=

# Baseten (optional, Muse Spark Open): model id is meta-models/muse-spark-open-1026
BASETEN_API_KEY=

# Budget guard (USD) — hard cap kept well below the credits
BUDGET_HARD_CAP_USD=100
DEMO_PAID_CALLS_ENABLED=true
# A run on a brand-new map area spends about $0.45 on SAM (two tilings) plus a few cents of text calls; bundled samples cost almost nothing.
RUN_CAP_USD=1.00
# META_BASE_URL=https://api.meta.ai/v1
# Which endpoint serves the text-reasoning steps (request parsing, repair decisions): meta | baseten | modal
# "baseten" runs the open-weight Muse Spark Open (needs BASETEN_API_KEY); SAM and vision stay on the Meta API.
REASONING_PROVIDER=meta
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# Baseten credits are a separate pot ($100): our own spend counter and cap for them (estimated conservatively)
# BASETEN_BUDGET_CAP_USD=60

# Behind a reverse proxy: take the caller's address from X-Forwarded-For (only if you really have a trusted proxy in front).
# The client is TRUSTED_PROXY_HOPS entries from the right, because the first entry is whatever the caller wrote.
# TRUST_PROXY=1
# TRUSTED_PROXY_HOPS=1

# Modal: a shared Endpoint serving the open-weight Muse Spark Open (a backup to Baseten, billed per token).
#   modal endpoint create --shared --name orbitroute-spark-open --model meta-models/Muse-Spark-Open-816B-A42B
#   modal workspace proxy-tokens create     # the proxy token is "<id>.<secret>"
# MODAL_ENDPOINT_URL=https://<workspace>--ep-orbitroute-spark-open-server.us-west.modal.direct/v1
# MODAL_ENDPOINT_TOKEN=
# MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
# MODAL_BUDGET_CAP_USD=60
